nfraestrutura de transportes, exercidas por terceiros, visando garantir a movimenta\u00e7\u00e3o de pessoas e bens, harmonizar os interesses dos usu\u00e1rios com os das empresas concession\u00e1rias, permission\u00e1rias, autorizadas e arrendat\u00e1rias, e de entidades delegadas, preservado o interesse p\u00fablico, arbitrar conflitos de interesses e impedir situa\u00e7\u00f5es que configurem competi\u00e7\u00e3o imperfeita ou infra\u00e7\u00e3o contra a ordem econ\u00f4mica.", "created": "2019-08-09T17:23:36.909648", "title": "Ag\u00eancia Nacional de Transportes Terrestres - ANTT", "name": "agencia-nacional-de-transportes-terrestres-antt", "is_organization": true, "state": "active", "image_url": "https://dados.antt.gov.br//base/images/2019-08-20-140517.470464LogoANTT.png", "revision_id": "45c74abd-f558-447e-94b5-d26cf5521ad0", "type": "organization", "id": "ce910523-bcba-4c8f-a01e-3b02b21bc495", "approval_status": "approved"}, "name": "volume-trafego-praca-pedagio", "isopen": true, "url": null, "notes": "Informa\u00e7\u00f5es de volume de tr\u00e1fego em cada pra\u00e7a de ped\u00e1gio das rodovias concedidas.", "owner_org": "ce910523-bcba-4c8f-a01e-3b02b21bc495", "extras": [{"key": "Categorias no VCGE", "value": "Transporte Rodovi\u00e1rio [http://vocab.e.gov.br/id/governo#transporte-rodoviario]"}, {"key": "Cobertura temporal", "value": "Anual"}, {"key": "Frequ\u00eancia de atualiza\u00e7\u00e3o", "value": "Mensal"}, {"key": "Granularidade geogr\u00e1fica", "value": "Nacional"}], "license_url": "http://www.opendefinition.org/licenses/cc-by", "title": "Volume de Tr\u00e1fego nas Pra\u00e7as de Ped\u00e1gio", "revision_id": "95f7b6c5-3a94-42c2-8c19-2e9b51278519"}}